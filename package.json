{
  "name": "accessradar",
  "version": "0.1.0",
  "private": true,
  "description": "AccessRadar – read-only Jira Cloud access review (Atlassian Forge, Runs on Atlassian)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build:ui": "vite build",
    "build": "npm run typecheck && npm run build:ui",
    "forge:lint": "forge lint --environment development",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build:ui && npm run forge:lint",
    "icons": "node scripts/export-icons.mjs"
  },
  "dependencies": {
    "@atlaskit/avatar": "^30.0.4",
    "@atlaskit/button": "^25.4.7",
    "@atlaskit/checkbox": "^19.3.0",
    "@atlaskit/css": "^1.1.6",
    "@atlaskit/css-reset": "^8.4.6",
    "@atlaskit/dropdown-menu": "^21.0.0",
    "@atlaskit/dynamic-table": "^19.3.8",
    "@atlaskit/empty-state": "^12.2.4",
    "@atlaskit/flag": "^19.0.0",
    "@atlaskit/form": "^18.2.0",
    "@atlaskit/heading": "^8.0.0",
    "@atlaskit/icon": "^38.0.2",
    "@atlaskit/lozenge": "^17.0.5",
    "@atlaskit/primitives": "^22.5.4",
    "@atlaskit/progress-bar": "^5.3.7",
    "@atlaskit/radio": "^10.2.5",
    "@atlaskit/section-message": "^10.2.6",
    "@atlaskit/select": "^23.1.2",
    "@atlaskit/side-navigation": "^13.3.6",
    "@atlaskit/spinner": "^20.4.4",
    "@atlaskit/tabs": "^21.3.0",
    "@atlaskit/textarea": "^10.2.7",
    "@atlaskit/textfield": "^10.2.6",
    "@atlaskit/toggle": "^17.3.4",
    "@atlaskit/tokens": "^20.4.1",
    "@forge/api": "^8.2.0",
    "@forge/bridge": "^7.1.0",
    "@forge/events": "^3.0.7",
    "@forge/resolver": "^2.0.0",
    "@forge/sql": "^4.0.7",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "prosemirror-view": "1.42.6"
  }
}
