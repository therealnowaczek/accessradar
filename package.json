{
  "name": "accessradar",
  "version": "0.1.0",
  "private": true,
  "description": "AccessRadar – read-only Jira Cloud access review (Atlassian Forge, Runs on Atlassian)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:ui": "npm --prefix static/accessradar-ui run build",
    "build": "npm run typecheck && npm run build:ui",
    "forge:lint": "forge lint --environment development"
  },
  "dependencies": {
    "@forge/api": "^8.2.0",
    "@forge/events": "^3.0.7",
    "@forge/resolver": "^2.0.0",
    "@forge/sql": "^4.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
